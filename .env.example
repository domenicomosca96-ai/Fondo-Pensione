GEMINI_API_KEY=your_gemini_api_key_here

# SMTP per l'invio del report PDF via email
# (lascia vuoto se non vuoi abilitare l'invio email — il PDF resta scaricabile lato client)
SMTP_HOST=smtps.aruba.it
SMTP_PORT=587
SMTP_USER=info@example.it
SMTP_PASS=your_smtp_password
SMTP_SSL=false
SMTP_FROM=info@example.it
SMTP_FROM_NAME=Vantaggio Pensione
SMTP_OWNER_EMAIL=domenico.mosca@example.it
