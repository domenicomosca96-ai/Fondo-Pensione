# Blocca accesso diretto a file sensibili via web (Apache).
<FilesMatch "^(config\.php|config\.php\.example|.*\.log|composer\.json|composer\.lock)$">
    Require all denied
</FilesMatch>

# Fallback per Apache 2.2 (alcune versioni di Aruba)
<IfModule !mod_authz_core.c>
    <FilesMatch "^(config\.php|config\.php\.example|.*\.log|composer\.json|composer\.lock)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# Forza UTF-8 sui contenuti HTML
AddDefaultCharset UTF-8
