    'SMTP_PORT' => 587,                           // 587 STARTTLS  |  465 SSL
    'SMTP_USER' => '',                            // username (di solito = email mittente)
    'SMTP_PASS' => '',                            // password (Gmail: App Password, anche con spazi)
    'SMTP_SSL'  => false,                         // true = SSL diretto (porta 465); false = STARTTLS (587)
    'SMTP_DEBUG'=> false,                         // true = log dettagliato in invia-report.log

    // ====== Mittente ======
